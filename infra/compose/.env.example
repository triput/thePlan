# Compose env (gitignored)

# Cloudflare Tunnel connector token from Zero Trust → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=

# API session hardening when serving over HTTPS via Tunnel
# SESSION_HTTPS_ONLY=true
# SESSION_SECRET=generate-a-long-random-string

# Wave 2a Google Calendar (tunnel)
# FRONTEND_ORIGIN=https://plan.silverhelmet.com
# GOOGLE_CLIENT_SECRETS_FILE=/secrets/thePlan_client_secret_....apps.googleusercontent.com.json
# GOOGLE_REDIRECT_URI=https://plan.silverhelmet.com/api/v1/calendar/oauth/google/callback
# TOKEN_ENCRYPTION_KEY=  # Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly

# Wave 3 Slice 2 Microsoft Calendar (Entra / Graph)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=https://plan.silverhelmet.com/api/v1/calendar/oauth/microsoft/callback
# MICROSOFT_TENANT_ID=common
# TOKEN_ENCRYPTION_KEY=  # same Fernet key as Google
