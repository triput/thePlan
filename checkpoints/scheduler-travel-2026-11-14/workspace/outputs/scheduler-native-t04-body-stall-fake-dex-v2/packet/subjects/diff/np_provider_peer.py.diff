+    def _hold_stall(self, *, deadline: float, deadline_message: str) -> None:
+        """Hold a scripted header/body stall (Trish-approved decision 4F2F3B3F).
+
+        Returns cleanly ONLY when the owning runner's stop event (set by
+        retire_owned) ends the stall strictly before the peer deadline; the exit
+        reason is then "retired". Peer-deadline expiry remains an error (reason
+        "deadline") and the unchanged PeerLifecycleError is raised, so the selected
+        retirement helper still refuses it. Finite monotonic instants only.
+        """
+        self.life.stall_entered_at = monotonic()
+        while monotonic() < deadline and not self._stop.is_set():
+            select.select([], [], [], ACCEPT_POLL_SECONDS)
+        exited = monotonic()
+        self.life.stall_exit_at = exited
+        if self._stop.is_set() and exited < deadline:
+            self.life.stall_exit_reason = "retired"
+            return
+        self.life.stall_exit_reason = "deadline"
+        raise PeerLifecycleError(deadline_message)
