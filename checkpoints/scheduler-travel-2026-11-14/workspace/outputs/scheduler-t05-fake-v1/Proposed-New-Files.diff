+    try:
+        try:
+            (
+                stdout_raw,
+                stderr_raw,
+                timed_out,
+                pe,
+                capture_stop_reason,
+                collect_secondary,
+                reader_framing_original,
+                interrupt_reason,
+            ) = _collect_bounded(proc, timeout=TIMEOUT_SECONDS)
