+def t03_valid_fixed_length_get_script() -> ExchangeScript:
+    """NP-T03 B2a finite GET (decision D46E6CF8): complete fixed-length "{}" + orderly close.
+
+    VALID serves it to completion. WRONG-CA and WRONG-NAME reuse the same script; the
+    client refuses the certificate inside JoinedTLS.open, so the peer must never reach
+    recv_request (refusal before any useful application data).
+    """
+    return ExchangeScript(
+        script_id="T03-B2A-FIXED-LENGTH-GET",
+        purpose="t03_b2a_fixed_length_get",
+        steps=(
+            ExchangeStep("recv_request", method="GET", path=T03_GET_PATH),
+            ExchangeStep(
+                "send_response",
+                status=200,
+                headers=(("Content-Type", "application/json"), ("Content-Length", "PLACEHOLDER")),
+                body_template=T03_VALID_BODY,
+                note="Complete fixed-length body; Content-Length equals body length",
+            ),
+            ExchangeStep("close", close_mode="orderly_close_notify"),
+        ),
+    )
