+def google_calendar_list_script(
+    *, exact_query: str, primary_calendar_id: str, other_calendar_ids: tuple[str, ...] | list[str]
+) -> ExchangeScript:
+    """GET /calendar/v3/users/me/calendarList?{exact_query}: one complete page.
+
+    Exactly one entry is marked primary (calendar_alias_canonicalize reads items[].primary or
+    isDefaultCalendar and items[].id; more than one primary is ambiguous). No nextPageToken.
+    """
+    import json
+
+    if not exact_query or "?" in exact_query or "#" in exact_query:
+        raise RuntimeError("google calendarList script requires one exact non-empty wire query")
+    others = tuple(other_calendar_ids)
+    if primary_calendar_id in others or len(set(others)) != len(others):
+        raise RuntimeError("google calendarList needs one distinct primary entry")
+    items = [{"id": primary_calendar_id, "primary": True}] + [{"id": cid} for cid in others]
+    body = json.dumps({"kind": "calendar#calendarList", "items": items}, separators=(",", ":"))
+    return ExchangeScript(
+        script_id="GOOGLE-CALENDAR-LIST-ONE-PAGE",
