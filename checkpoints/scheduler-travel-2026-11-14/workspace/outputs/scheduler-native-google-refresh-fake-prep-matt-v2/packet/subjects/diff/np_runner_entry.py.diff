+def _measure_google_credential_state(
+    db: Any, *, settings: Any, account_id: UUID, reference_instant: datetime
+) -> dict[str, Any]:
+    """Fresh persisted read of one Google account's credential columns (semantic, not ciphertext).
+
+    Decrypts with the UNCHANGED production token_crypto inside the fixture and compares with the
+    declared seed and refreshed values. Emits only booleans and the persisted expiry instant;
+    plaintext and ciphertext are never returned.
+    """
+    from np_provider_transcript import GOOGLE_REFRESHED_ACCESS_PLAINTEXT, GOOGLE_ROTATED_REFRESH_PLAINTEXT
+    from app.models import CalendarAccount
+    from app.services.token_crypto import decrypt_token
+
+    account = db.get(CalendarAccount, account_id)
+    if account is None:
+        raise RuntimeError("calendar account missing for credential measurement")
+    access = decrypt_token(settings, account.access_token_enc) if account.access_token_enc else None
+    refresh = decrypt_token(settings, account.refresh_token_enc) if account.refresh_token_enc else None
+    expiry = account.token_expires_at
+    if expiry is not None and expiry.tzinfo is None:
+        expiry = expiry.replace(tzinfo=timezone.utc)
+    return {
+        "seed_access_match": access == GOOGLE_SEED_ACCESS_PLAINTEXT,
+        "seed_refresh_match": refresh == GOOGLE_SEED_REFRESH_PLAINTEXT,
+        "refreshed_access_match": access == GOOGLE_REFRESHED_ACCESS_PLAINTEXT,
+        "rotated_refresh_match": refresh == GOOGLE_ROTATED_REFRESH_PLAINTEXT,
+        "expiry": expiry.isoformat() if expiry is not None else None,
+        "expiry_at_or_before_reference": bool(expiry is not None and expiry <= reference_instant),
+    }
+
