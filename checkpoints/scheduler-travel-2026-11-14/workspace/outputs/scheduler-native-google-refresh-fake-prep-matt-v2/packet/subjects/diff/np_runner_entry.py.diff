+def _measure_google_events(db: Any, *, account_ids: list[UUID]) -> list[dict[str, Any]]:
+    """Fresh persisted read of ExternalCalendarEvent rows for the given accounts (no titles)."""
+    from app.models import ExternalCalendarEvent
+
+    def utc(value: datetime) -> str:
+        return (value if value.tzinfo is not None else value.replace(tzinfo=timezone.utc)).astimezone(
+            timezone.utc
+        ).isoformat()
+
+    rows = (
+        db.query(ExternalCalendarEvent)
+        .filter(ExternalCalendarEvent.calendar_account_id.in_(list(account_ids)))
+        .all()
+    )
+    out = [
+        {
+            "owner_id": str(row.owner_id),
+            "calendar_account_id": str(row.calendar_account_id),
+            "provider": getattr(row.provider, "value", str(row.provider)),
+            "external_event_id": row.external_event_id,
+            "calendar_id": row.calendar_id,
+            "start_utc": utc(row.start_time),
+            "end_utc": utc(row.end_time),
+            "is_all_day": bool(row.is_all_day),
+            "transparency": row.transparency,
+            "free_busy_provenance": row.free_busy_provenance,
+            "is_provider_cancelled": bool(row.is_provider_cancelled),
+            "pending_deletion": bool(row.pending_deletion),
+            "scheduled_block_absent": row.scheduled_block_id is None,
+            "source_zone_missing": bool(row.source_zone_missing),
+        }
+        for row in rows
+    ]
+    return sorted(out, key=lambda item: (item["calendar_id"], item["external_event_id"]))
+
