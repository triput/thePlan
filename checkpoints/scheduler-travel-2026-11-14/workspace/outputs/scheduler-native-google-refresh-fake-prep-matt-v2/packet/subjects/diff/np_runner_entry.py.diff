+def _google_provider_routes(*, api_route: Any, token_route: Any):
+    """Google route classification for CoveringHTTP: exact OAuth /token, exact identity
+    calendarList, and the event prefix (provider_context: identity/oauth exact, event prefix)."""
+    from app.services.covering_transport_policy import HTTPSPeer
+
+    api_peer = HTTPSPeer(
+        hostname=api_route.server_hostname,
+        address=api_route.dial_address,
+        port=api_route.dial_port,
+        ca_file=api_route.ca_path,
+    )
+    token_peer = HTTPSPeer(
+        hostname=token_route.server_hostname,
+        address=token_route.dial_address,
+        port=token_route.dial_port,
+        ca_file=token_route.ca_path,
+    )
+    return (
+        (token_peer, "/token", "oauth"),
+        (api_peer, GOOGLE_CALENDAR_LIST_PATH, "identity"),
+        (api_peer, GOOGLE_EVENTS_PREFIX, "event"),
+    )
+
