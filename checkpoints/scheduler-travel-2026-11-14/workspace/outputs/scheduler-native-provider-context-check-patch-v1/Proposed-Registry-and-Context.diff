+def _case_decl_ids_from_assign(node: ast.AST) -> list[str]:
+    if not isinstance(node, (ast.Assign, ast.AnnAssign)):
+        raise WitnessFailure("registry must be a literal assignment")
+    value = node.value
+    if not isinstance(value, (ast.Tuple, ast.List)):
+        raise WitnessFailure("registry must be a literal tuple/list")
+    ids: list[str] = []
+    for entry in value.elts:
+        if (not isinstance(entry, ast.Call) or not isinstance(entry.func, ast.Name)
+                or entry.func.id != "CaseDecl" or not entry.args
+                or not isinstance(entry.args[0], ast.Constant)
+                or not isinstance(entry.args[0].value, str)):
+            raise WitnessFailure("registry entry must be a literal CaseDecl id")
+        ids.append(entry.args[0].value)
+    return ids
+
+
+def check_suite_inventory_ast() -> dict[str, Any]:
+    tree = ast.parse((FIXTURE / "np_suite.py").read_text(encoding="utf-8"))
+    expected = load_expected()
+    declarations: dict[str, ast.AST] = {}
+    for node in tree.body:
+        if isinstance(node, ast.Assign):
+            targets = node.targets
+        elif isinstance(node, ast.AnnAssign):
+            targets = [node.target]
+        else:
+            continue
+        for target in targets:
+            if isinstance(target, ast.Name) and target.id in ("NATIVE_CASES", "CF_WITNESS_CASES"):
+                if target.id in declarations:
+                    raise WitnessFailure("duplicate registry declaration")
+                declarations[target.id] = node
+    if set(declarations) != {"NATIVE_CASES", "CF_WITNESS_CASES"}:
+        raise WitnessFailure("missing registry declaration")
+    native_ids = _case_decl_ids_from_assign(declarations["NATIVE_CASES"])
+    cf_ids = _case_decl_ids_from_assign(declarations["CF_WITNESS_CASES"])
+    if native_ids != expected["native_case_ids"] or cf_ids != expected["cf_witness_case_ids"]:
+        raise WitnessFailure("exact registry ID/order mismatch")
+    if len(set(native_ids + cf_ids)) != len(native_ids) + len(cf_ids):
+        raise WitnessFailure("duplicate case id across registries")
+    native_tuple = declarations["NATIVE_CASES"].value
+    close_case = native_tuple.elts[native_ids.index("NP-T05-ORDERLY-CLOSE")]
+    names = set()
+    for node in ast.walk(close_case):
+        if not isinstance(node, ast.Call):
+            continue
+        for keyword in node.keywords:
+            if keyword.arg == "name" and isinstance(keyword.value, ast.Constant):
+                names.add(keyword.value.value)
+    required = {"orderly_close_delimited_complete_accepted", "orderly_short_cl_valid_json_prefix_refused"}
+    if not required <= names:
+        raise WitnessFailure("orderly dual oracle declarations missing from exact case")
+    return {
+        "native_count": len(native_ids), "cf_count": len(cf_ids),
+        "native_ids_in_order": native_ids, "cf_ids_in_order": cf_ids,
+        "orderly_dual_observations": True, "observed": "PASS",
+    }
+
