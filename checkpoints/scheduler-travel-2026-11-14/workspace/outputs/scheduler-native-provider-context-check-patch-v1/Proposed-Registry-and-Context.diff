+def _selected_context_namespace(src: str, *, mutation: str | None = None) -> dict[str, Any]:
+    tree = ast.parse(src)
+    assignments = [node for node in tree.body if isinstance(node, ast.Assign)
+                   and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)
+                   and node.targets[0].id == "_current"]
+    managers = [node for node in tree.body if isinstance(node, ast.FunctionDef)
+                and node.name == "covering_provider_transport"]
+    if len(assignments) != 1 or len(managers) != 1:
+        raise WitnessFailure("selected context definition inventory")
+    manager = copy.deepcopy(managers[0])
+    if mutation == "NO_NEST_GUARD":
+        if not isinstance(manager.body[0], ast.If):
+            raise WitnessFailure("nested-guard mutation target changed")
+        manager.body.pop(0)
+    elif mutation == "NO_FINALLY_RESET":
+        scopes = [node for node in manager.body if isinstance(node, ast.Try)]
+        if len(scopes) != 1 or not scopes[0].finalbody:
+            raise WitnessFailure("finally-reset mutation target changed")
+        scopes[0].finalbody = [ast.Pass()]
+    elif mutation is not None:
+        raise WitnessFailure("unknown context mutation")
+
+    class FakeRefused(Exception):
+        pass
+
+    namespace: dict[str, Any] = {
+        "ContextVar": ContextVar, "contextmanager": contextmanager,
+        "CoveringTransportRefused": FakeRefused,
+    }
+    module = ast.Module(body=[copy.deepcopy(assignments[0]), manager], type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module), "<pinned-selected-context>", "exec"), namespace)
+    return namespace
+
+
+def _probe_selected_context(namespace: dict[str, Any]) -> None:
+    manager = namespace["covering_provider_transport"]
+    current = namespace["_current"]
+    refused_type = namespace["CoveringTransportRefused"]
+    if current.get() is not None:
+        raise WitnessFailure("context initial state")
+    with manager("A"):
+        if current.get() != "A":
+            raise WitnessFailure("context active value")
+    if current.get() is not None:
+        raise WitnessFailure("normal-exit reset missing")
+
+    class ProbeError(Exception):
+        pass
+
+    escaped = False
+    try:
+        with manager("B"):
+            raise ProbeError()
+    except ProbeError:
+        escaped = True
+    if not escaped or current.get() is not None:
+        raise WitnessFailure("exception propagation/reset missing")
+    with manager("C"):
+        nested_refused = False
+        try:
+            with manager("D"):
+                pass
+        except refused_type:
+            nested_refused = True
+        if not nested_refused or current.get() != "C":
+            raise WitnessFailure("nested refusal/outer preservation missing")
+    if current.get() is not None:
+        raise WitnessFailure("outer reset after refusal missing")
+
+
+def check_t08_nested_reset_behavior() -> dict[str, Any]:
+    path = API / "app/services/covering_provider_context.py"
+    raw = path.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest().upper()
+    if digest != PROVIDER_CONTEXT_PIN:
+        raise WitnessFailure("selected provider context raw pin mismatch")
+    source = raw.decode("utf-8")
+    Context().run(_probe_selected_context, _selected_context_namespace(source))
+    mutations = []
+    for mutation in ("NO_NEST_GUARD", "NO_FINALLY_RESET"):
+        namespace = _selected_context_namespace(source, mutation=mutation)
+        detected = False
+        try:
+            Context().run(_probe_selected_context, namespace)
+        except WitnessFailure:
+            detected = True
+        if not detected:
+            raise WitnessFailure("context mutation survived the same behavioral oracle")
+        mutations.append(mutation)
+    return {
+        "t08_nested": "OBSERVED_REFUSE", "t08_reset_normal": "OBSERVED_RESET",
+        "t08_reset_exceptional": "OBSERVED_RESET", "selected_context_sha256": digest,
+        "observation_review_pin": OBSERVATION_REVIEW_PIN,
+        "closes_native_foreign_thread_close_reuse": False,
+        "source_definitions_extracted": True, "mutations_rejected": mutations,
+        "observed": "PASS",
+    }
