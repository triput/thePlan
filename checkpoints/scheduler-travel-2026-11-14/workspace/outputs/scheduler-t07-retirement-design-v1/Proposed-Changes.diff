@@ -122,8 +122,24 @@ class CoveringHTTP:
                 # Token rotation may have occurred. No retry/replay.
                 raise CoveringRootOutcomeUnknown() from None
             raise
         finally:
-            if response is not None:
-                response.close()
-            transport.close()
+            # Independently owned retirement attempts. A response-close
+            # failure must not skip transport-close. Any cleanup failure
+            # cancels a pending success and replaces typed exchange
+            # outcomes with UNKNOWN while leaving the prior exception in
+            # __context__ (do not use "from None" here).
+            cleanup_failed = False
+            if response is not None:
+                try:
+                    response.close()
+                except BaseException:
+                    cleanup_failed = True
+            try:
+                transport.close()
+            except BaseException:
+                cleanup_failed = True
+            if cleanup_failed:
+                raise CoveringRootOutcomeUnknown()
 
