+# NP-T03 B2a (Trish-approved decision D46E6CF8; Dex 21BBE5B7). Direct production
+# CoveringHTTP -> default JoinedTLS to the synthetic Google API peer on numeric
+# loopback :443 with verify-full; no application schema, DB or ASGI is touched.
+T03_CERT_REFUSAL_OUTCOME = ("exception", "SSLCertVerificationError", "ssl")
+T03_VALID_OUTCOME = ("response", 200, True)
+# Fail-closed peer-side hypothesis (D1), NOT a claim about native runtime behavior.
+T03_NEGATIVE_PEER_ERROR_KINDS = frozenset({"SSLError", "SSLEOFError", "ConnectionResetError"})
+T03_NEGATIVE_PEER_PHASE = "accepted"
+T03_EXPECTATIONS = ("valid", "wrong_ca", "wrong_name")
+T03_ORACLES = {
+    "NP-T03-VALID": "handshake_and_useful_app_data",
+    "NP-T03-WRONG-CA": "refuse_before_useful_application_data",
+    "NP-T03-WRONG-NAME": "refuse",
+}
