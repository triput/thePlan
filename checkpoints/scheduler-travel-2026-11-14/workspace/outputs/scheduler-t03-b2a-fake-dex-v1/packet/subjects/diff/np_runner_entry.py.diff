+def _run_np_t03_case(case_id: str, expectation: str) -> dict[str, Any]:
+    from np_suite import check_oracles_immediate, registry_by_id
+    from np_receipts import case_result_receipt
+
+    decl = registry_by_id(include_cf=True)[case_id]
+    t_plan_iso = _iso_now()
+    observed = _t03_observe(case_id, expectation)
+    observations = {T03_ORACLES[case_id]: "OBSERVED"}
+    check_oracles_immediate(decl, observations)
+    return case_result_receipt(
+        case_id=case_id,
+        passed=True,
+        workers_joined=True,
+        expected_unknown=False,
+        executed=True,
+        prep_is_not_pass=True,
+        observations=observations,
+        t_plan_iso=t_plan_iso,
+        t_check_iso=_iso_now(),
+        measured={key: value for key, value in observed.items() if key != "inventory"},
+        peer_exchange_inventory=observed["inventory"],
+        resource_disposition={
+            "peer_retired": True,
+            "peer_joined": True,
+            "schema_provisioned": False,
+            "provider_pki_status": (
+                "GENERATED"
+                if _PROVIDER_PKI_GENERATE_ONCE_DONE
+                else ("PREPARED_NOT_GENERATED" if _PROVIDER_PKI_PREPARED else "NOT_PREPARED")
+            ),
+        },
+    )
+
+
+def _run_np_t03_valid() -> dict[str, Any]:
+    return _run_np_t03_case("NP-T03-VALID", "valid")
