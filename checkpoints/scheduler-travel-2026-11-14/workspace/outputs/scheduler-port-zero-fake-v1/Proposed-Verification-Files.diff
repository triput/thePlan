+
+def sha256_file(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest().upper()
+
+
+def _require_nonempty_pin(label: str, value: Any) -> str:
+    """Empty conditional pin literals must not silently waive checks at freeze."""
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"empty_or_invalid_pin:{label}")
+    return value.strip().upper()
+
+
+def write_receipt(payload: dict) -> None:
+    """Exclusive-create only. Never overwrite a preexisting RECEIPT (P6).
+
+    Uses O_CREAT|O_EXCL so a racing/prior receipt cannot be clobbered.
+    Callers that must refuse when prior evidence exists must STOP without
+    invoking this function.
+    """
+    data = (json.dumps(payload, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
+    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
+    if hasattr(os, "O_BINARY"):
+        flags |= os.O_BINARY
+    fd = os.open(str(RECEIPT), flags, 0o644)
+    try:
+        view = memoryview(data)
+        while view:
+            written = os.write(fd, view)
+            view = view[written:]
+    finally:
+        os.close(fd)
+
+
+def _refuse_without_writing(reason: str, **extra: Any) -> int:
+    """STOP/refuse to stderr only — do not create or overwrite RECEIPT/RESULT."""
+    payload = {"status": "STOP", "reason": reason, **extra}
+    print(f"launcher refuses admission: {reason}", file=sys.stderr)
+    print(json.dumps(payload, indent=2, ensure_ascii=False), file=sys.stderr)
+    return 125
