+def validate_result_file(
+    *,
+    started_at: float,
+    expected_inputs: dict[str, Any],
+    expected_wire_ids: list[str],
+) -> tuple[bool, str | None, str | None, int | None]:
+    """Refuse PASS from exit0 alone.
+
+    Gates: fresh mtime, size before read, well-formed JSON, status PASS,
+    class FAKE-PORT, exact wire IDs *and order*, every
+    expected exact_predicate (not broad allowed sets), inventory_error is None,
+    source_hashes_verified True, executed True. Malformed / missing /
+    mismatched inventory → refuse.
+    """
+    if not RESULT.is_file():
+        return False, None, "missing_result", None
+    try:
+        st = RESULT.stat()
+        mtime = st.st_mtime
+        size = int(st.st_size)
+    except OSError:
+        return False, None, "result_stat_failed", None
+    if mtime + 0.001 < started_at:
+        return False, None, "stale_preexisting_result", size
+    # Size gate BEFORE read_bytes — retained-tail alone ≠ capture limit.
+    if size > CAPTURE_RESULT_BYTES:
+        return False, None, "result_exceeds_capture_limit", size
+    raw = RESULT.read_bytes()
+    read_bytes = len(raw)
+    if read_bytes > CAPTURE_RESULT_BYTES:
+        return False, sha256_file(RESULT), "result_exceeds_byte_limit", read_bytes
+    try:
+        payload = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return False, sha256_file(RESULT), "malformed_result", read_bytes
+    if not isinstance(payload, dict):
+        return False, sha256_file(RESULT), "malformed_result", read_bytes
+    if payload.get("status") != "PASS":
+        return False, sha256_file(RESULT), "result_status_not_pass", read_bytes
+    if payload.get("class") != "FAKE-PORT":
+        return False, sha256_file(RESULT), "result_class_mismatch", read_bytes
+    if payload.get("inventory_error") is not None:
+        return False, sha256_file(RESULT), "inventory_error_present", read_bytes
+    if payload.get("source_hashes_verified") is not True:
+        return False, sha256_file(RESULT), "source_hashes_not_verified", read_bytes
+    if payload.get("executed") is not True:
+        return False, sha256_file(RESULT), "executed_not_true", read_bytes
+
+    order = payload.get("wire_ids_in_order")
+    controls = payload.get("inputs")
+    if not isinstance(order, list) or not isinstance(controls, dict):
+        return False, sha256_file(RESULT), "malformed_inventory", read_bytes
+    if order != expected_wire_ids:
+        return False, sha256_file(RESULT), "control_ids_order_mismatch", read_bytes
+    if list(controls.keys()) != expected_wire_ids:
+        return False, sha256_file(RESULT), "inputs_key_order_mismatch", read_bytes
+    if set(controls.keys()) != set(expected_wire_ids):
+        return False, sha256_file(RESULT), "inputs_set_mismatch", read_bytes
+    for wid, spec in expected_inputs.items():
+        entry = controls.get(wid)
+        if not isinstance(entry, dict):
+            return False, sha256_file(RESULT), f"missing_wire_{wid}", read_bytes
+        # v4: exact predicates replace broad allowed_outcomes sets.
+        pred = spec.get("exact_predicate")
+        if not isinstance(pred, dict) or not pred:
+            return False, sha256_file(RESULT), f"missing_exact_predicate_{wid}", read_bytes
+        if entry.get("observed_outcome") != spec.get("predicted_outcome"):
+            return (
+                False,
+                sha256_file(RESULT),
+                f"wire_outcome_mismatch_{wid}",
+                read_bytes,
+            )
+        for key, expected_val in pred.items():
+            if key not in entry or json.dumps(entry[key], sort_keys=True) != json.dumps(expected_val, sort_keys=True):
+                return (
+                    False,
+                    sha256_file(RESULT),
+                    f"wire_predicate_mismatch_{wid}_{key}",
+                    read_bytes,
