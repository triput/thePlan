+        if not stdout_retained.endswith("\n"):
+            sys.stdout.write("\n")
+    if stderr_retained:
+        sys.stderr.write(stderr_retained)
+        if not stderr_retained.endswith("\n"):
+            sys.stderr.write("\n")
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
