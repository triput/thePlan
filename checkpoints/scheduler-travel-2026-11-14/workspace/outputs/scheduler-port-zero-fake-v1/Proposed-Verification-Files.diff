+def _stop_receipt(reason: str, **extra: Any) -> int:
+    """Write a newly owned STOP receipt via exclusive create, or refuse cleanly.
+
+    If RECEIPT already exists, do not overwrite — emit stderr-only STOP (P6).
+    Early admission failures that run before the preexisting-evidence gate must
+    use this path (or _refuse_without_writing) so prior RESULT/RECEIPT survive.
+    """
+    if RECEIPT.is_file() or RESULT.is_file():
+        return _refuse_without_writing(
+            reason,
+            preexisting_receipt=RECEIPT.is_file(),
+            preexisting_result=RESULT.is_file(),
+            preexisting_receipt_sha256=(
+                sha256_file(RECEIPT) if RECEIPT.is_file() else None
+            ),
+            preexisting_result_sha256=(
+                sha256_file(RESULT) if RESULT.is_file() else None
+            ),
+            **extra,
+        )
+    try:
+        write_receipt({"status": "STOP", "reason": reason, **extra})
+    except FileExistsError:
+        return _refuse_without_writing(
+            "receipt_exclusive_create_failed_preexisting",
+            attempted_reason=reason,
+            **extra,
+        )
+    print(f"launcher refuses admission: {reason}", file=sys.stderr)
