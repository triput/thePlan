+            if response_close_exc is not None or transport_close_exc is not None:
+                # Active primary (if any) is still visible via sys.exc_info
+                # inside finally until this new raise replaces it.
+                primary = sys.exc_info()[1]
+                if isinstance(primary, CoveringRootOutcomeUnknown):
+                    # Enrich existing UNKNOWN rather than nest a second one.
+                    # Merge: do not wipe JoinedTLS-attached transport_close
+                    # when the outer close is a closed=True no-op (None).
+                    if response_close_exc is not None:
+                        primary.response_close = response_close_exc
+                    if transport_close_exc is not None:
+                        primary.transport_close = transport_close_exc
+                    primary.retirement_provenance = (
+                        getattr(primary, "primary", None),
+                        getattr(primary, "response_close", None),
+                        getattr(primary, "transport_close", None),
+                    )
+                    raise primary
+                unknown = CoveringRootOutcomeUnknown()
+                unknown.primary = primary
+                unknown.response_close = response_close_exc
+                unknown.transport_close = transport_close_exc
+                unknown.retirement_provenance = (
+                    primary, response_close_exc, transport_close_exc,
+                )
+                raise unknown
 
