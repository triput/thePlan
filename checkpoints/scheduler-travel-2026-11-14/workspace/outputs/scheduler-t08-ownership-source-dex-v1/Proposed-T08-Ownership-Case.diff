+def _run_np_t08_ownership() -> dict[str, Any]:
+    """One actual JoinedTLS socket: foreign check/close, owner use/close, reuse refusal.
+
+    Source preparation only. A later launch must admit the owned foreign thread's
+    single five-second join and the existing peer's bounded retirement. This is
+    transport ownership proof, not HTTP framing, OAuth or assessment composition.
+    """
+    from np_suite import SuiteStop, check_oracles_immediate, registry_by_id
+    from np_receipts import case_result_receipt
+    from np_provider_routes import google_api_route
