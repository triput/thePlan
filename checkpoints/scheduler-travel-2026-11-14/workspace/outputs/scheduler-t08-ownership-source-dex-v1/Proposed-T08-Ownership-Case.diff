+    from np_provider_peer import SyntheticProviderPeer, PeerMaterial, _http_response_bytes
+    from app.services.covering_joined_https import JoinedTLS
+    from app.services.covering_request_budget import CoveringRequestBudget
+    from app.services.covering_transport_policy import HTTPSPeer, CoveringTransportRefused
+
+    case_id = "NP-T08-OWNERSHIP"
+    decl = registry_by_id(include_cf=True)[case_id]
+    planned_at = _iso_now()
+    route = google_api_route()
+    path = "/calendar/v3/calendars/primary/events"
+    response_step = ExchangeStep(
+        "send_response", status=200,
+        headers=(("Content-Type", "application/json"), ("Content-Length", "2")),
+        body_template="{}",
+    )
+    script = ExchangeScript(
+        script_id="T08-OWNED-SOCKET-ONE-GET", purpose="transport_ownership",
+        steps=(ExchangeStep("recv_request", method="GET", path=path), response_step,
+               ExchangeStep("close", close_mode="orderly_close_notify")),
+    )
+    expected_wire = _http_response_bytes(response_step)
+    peer = SyntheticProviderPeer(peer_id=case_id, route=route, script=script, material=PeerMaterial())
+    budget = CoveringRequestBudget()
+    transport = JoinedTLS(HTTPSPeer(hostname=route.server_hostname, address=route.dial_address,
+                                   port=route.dial_port, ca_file=route.ca_path), budget.work_remaining)
+    foreign = None
+    foreign_started = False
+    foreign_join_attempted = False
+    peer_retirement_attempted = False
+    owner_close_attempted = False
+    primary_failure = None
+    foreign_results = []
+    unexpected_foreign = []
+    observations = {}
+    try:
+        peer.start_background(seconds=PEER_SECONDS_DEFAULT)
+        transport.open()
+        owned_socket = transport.sock
+        owned_fd = owned_socket.fileno()
+        if transport.closed or owned_fd < 0:
+            raise SuiteStop("t08 owner did not open a live TLS socket")
+
+        def foreign_access():
+            for label, operation in (("foreign_check", transport.check), ("foreign_close", transport.close)):
+                try:
+                    operation()
+                except BaseException as exc:
+                    foreign_results.append((label, type(exc) is CoveringTransportRefused))
+                else:
+                    foreign_results.append((label, False))
+
+        def foreign_worker():
+            try:
+                foreign_access()
+            except BaseException as exc:
+                unexpected_foreign.append(type(exc).__name__)
+
+        foreign = threading.Thread(target=foreign_worker, name="np-t08-foreign-owned", daemon=False)
+        foreign.start()
+        foreign_started = True
+        foreign_join_attempted = True
+        foreign.join(timeout=5.0)
+        if foreign.is_alive():
+            raise SuiteStop("t08 foreign worker unjoined UNKNOWN")
+        if unexpected_foreign or foreign_results != [("foreign_check", True), ("foreign_close", True)]:
+            raise SuiteStop("t08 foreign ownership guards did not refuse exactly")
+        if transport.closed or transport.sock is not owned_socket or owned_socket.fileno() != owned_fd:
+            raise SuiteStop("t08 foreign access changed the owner socket state")
+        observations.update(foreign_check="OBSERVED", foreign_close="OBSERVED")
+
+        # A successful owner exchange proves the refused foreign close left it usable.
