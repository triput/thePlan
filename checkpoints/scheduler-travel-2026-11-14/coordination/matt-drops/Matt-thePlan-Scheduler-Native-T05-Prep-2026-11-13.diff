 def _http_response_bytes(step: ExchangeStep) -> bytes:
+    # Explicit framing selection; refusals happen here, before _send_response sends anything.
+    framing = getattr(step, "framing", "auto")
+    if framing not in RESPONSE_FRAMING_MODES:
+        raise PeerLifecycleError("unsupported response framing mode")
