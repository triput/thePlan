+def _measure_google_subscriptions(db: Any, *, subscription_ids: list[UUID]) -> list[dict[str, Any]]:
+    """Fresh persisted read of identity-relevant subscription columns (no summaries)."""
+    from app.models import CalendarSubscription
+
+    out = []
+    for sub_id in sorted(subscription_ids, key=str):
+        row = db.get(CalendarSubscription, sub_id)
+        if row is None:
+            raise RuntimeError("subscription missing for identity measurement")
+        out.append(
+            {
+                "subscription_id": str(row.id),
+                "external_calendar_id": row.external_calendar_id,
+                "role": getattr(row.role, "value", str(row.role)),
+                "is_enabled": bool(row.is_enabled),
+            }
+        )
+    return out
