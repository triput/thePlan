+def _install_google_parent_observer(parent_terminals: list[dict[str, Any]]) -> Callable[[], None]:
+    """Same-return/same-exception wrapper on CoveringParentAdapter.finish_root; restorable."""
+    from app.services.covering_parent_adapter import CoveringParentAdapter
+
+    real_finish_root = CoveringParentAdapter.finish_root
+
+    def observed_finish_root(self, *, commit):
+        try:
+            outcome = real_finish_root(self, commit=commit)
+        except BaseException as exc:
+            parent_terminals.append({"raised": type(exc).__name__, "commit_requested": bool(commit)})
+            raise
+        parent_terminals.append(
+            {"terminal": outcome.name if hasattr(outcome, "name") else str(outcome), "commit_requested": bool(commit)}
+        )
+        return outcome
+
+    def restore() -> None:
+        CoveringParentAdapter.finish_root = real_finish_root  # type: ignore[method-assign]
+
+    CoveringParentAdapter.finish_root = observed_finish_root  # type: ignore[method-assign]
+    return restore
+
