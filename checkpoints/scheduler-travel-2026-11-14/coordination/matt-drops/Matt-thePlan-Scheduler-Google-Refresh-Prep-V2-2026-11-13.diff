+def _measure_owner_revision_and_busy(db: Any, *, owner_id: UUID) -> dict[str, Any]:
+    """Fresh persisted owner scheduling revision (UserSettings) and the UNCHANGED production
+    immovable_busy_signature, reduced to a count and a 16-hex digest (no titles/bodies)."""
+    import hashlib
+
+    from app.models import UserSettings
+    from app.services.scheduling_revision import immovable_busy_signature
+
+    settings_row = db.query(UserSettings).filter(UserSettings.owner_id == owner_id).one()
+    signature = immovable_busy_signature(db, owner_id)
+    digest = hashlib.sha256(json.dumps([list(row) for row in signature]).encode("utf-8")).hexdigest()
+    return {
+        "scheduling_revision": int(settings_row.scheduling_revision),
+        "busy_interval_count": len(signature),
+        "busy_signature_sha256_16": digest[:16],
+    }
+
