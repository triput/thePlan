+def _google_calendar_list_exact_query() -> str:
+    """Exact calendarList wire query (google_calendar.list_google_calendars l.379 params; one
+    page, so no pageToken). Wire form is CoveringHTTP's urlencode(params, doseq=True)."""
+    from urllib.parse import urlencode
+
+    return urlencode({"maxResults": "250"}, doseq=True)
+
+
+def _google_events_exact_query(window_start: datetime, window_end: datetime) -> str:
+    """Exact Google events wire query (google_calendar.py l.409-416 params, in source order).
+
+    Production builds the dict inline in list_calendar_events (no separate builder), so the
+    keys/values are mirrored from source and the instants use the UNCHANGED production
+    google_calendar._iso_z over the production effective window (read-only pure calls). The
+    wire form is CoveringHTTP's urlencode(params, doseq=True); any mismatch fails closed as an
+    exact peer query mismatch.
+    """
+    from urllib.parse import urlencode
+
+    from app.services import google_calendar as production_google
+    from app.services.covering_refresh_window import effective_covering_pull_window
+
+    window = effective_covering_pull_window(window_start, window_end)
+    params = {
+        "timeMin": production_google._iso_z(window.effective_start),  # noqa: SLF001
+        "timeMax": production_google._iso_z(window.effective_end),  # noqa: SLF001
+        "singleEvents": "true",
+        "showDeleted": "true",
+        "orderBy": "startTime",
+        "maxResults": "2500",
+    }
+    return urlencode(params, doseq=True)
+
