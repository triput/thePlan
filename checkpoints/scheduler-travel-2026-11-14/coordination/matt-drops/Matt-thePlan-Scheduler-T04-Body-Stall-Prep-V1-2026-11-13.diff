+def _t04_finite_instant(name: str, value: Any) -> float:
+    import math
+
+    from np_suite import SuiteStop
+
+    if type(value) is not float or not math.isfinite(value):
+        raise SuiteStop(f"t04 body-stall instant missing or non-finite:{name}")
+    return value
