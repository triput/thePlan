+def _t05_response_outcome(
+    status: int, content: bytes, expected_body: bytes, scripted_wire: bytes
+) -> tuple[Any, ...]:
+    """Client-observed status/body plus framing of the exact scripted wire.
+
+    The httpx.Response that CoveringHTTP returns is rebuilt by production code and
+    httpx 0.28.1 supplies Content-Length for non-empty bytes content, so its headers
+    are NOT the wire headers. Framing absence is judged on the exact scripted bytes
+    (the peer's sent byte count is separately required to equal their length); the
+    client side contributes only its status and exact body.
+    """
+    head = scripted_wire.partition(b"\r\n\r\n")[0].lower()
+    scripted_wire_framing_headers_absent = (
+        b"\r\ncontent-length:" not in head and b"\r\ntransfer-encoding:" not in head
+    )
+    return ("response", status, content == expected_body, scripted_wire_framing_headers_absent)
+
